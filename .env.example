# Auth.js / NextAuth v5
# Generate AUTH_SECRET with: npx auth secret
# Do not commit real values. Copy this file to .env.local.

AUTH_SECRET=
# NEXTAUTH_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# Google Cloud authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://dolarnett.com/api/auth/callback/google

# FX: open feed is used by default (no key).
# Optional paid/key feed:
# EXCHANGE_RATE_API_KEY=
# Commission in PEN added on top of the send amount (default 0):
# COMMISSION_PEN=0
